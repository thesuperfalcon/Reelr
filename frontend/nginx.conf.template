# The access log carries nginx's request id, which the API logs as CorrelationId, so the two can be matched.
log_format reelr '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                 '"$http_referer" "$http_user_agent" request_id=$request_id';

# Behind a platform proxy that ends TLS (Azure Container Apps), nginx itself is reached over plain HTTP,
# so the scheme the browser used comes from that proxy's header.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Hide the nginx version.
    server_tokens off;

    access_log /var/log/nginx/access.log reelr;

    # Profile pictures are at most 1 MB; the default limit of 1 MB would refuse one with its form overhead.
    client_max_body_size 2m;

    # Compress text responses, including JSON from the API.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/problem+json image/svg+xml;

    include security-headers.conf;

    # Same routes the Vite dev server proxies, so the app needs no CORS setup.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # The backend's own name: Azure Container Apps routes internal requests by it.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Replaces any id the client sent.
        proxy_set_header X-Correlation-Id $request_id;
    }

    location /auth/ {
        proxy_pass ${BACKEND_URL};
        # The backend's own name: Azure Container Apps routes internal requests by it.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Replaces any id the client sent.
        proxy_set_header X-Correlation-Id $request_id;
    }

    # Built files have a content hash in their name, so a new version always has a new name
    # and browsers can keep these for good.
    location /assets/ {
        include security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Client-side routing: unknown paths fall back to the SPA entry point. index.html is checked with
    # the server on every visit, so a new deploy reaches users straight away.
    location / {
        include security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
