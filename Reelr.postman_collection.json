{
  "info": {
    "name": "Reelr API",
    "description": "Endpoints for MovieController (TMDB proxy).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Movie",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Movie/{{tmdbId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Movie", "{{tmdbId}}"]
        },
        "description": "Hämtar en film via TMDB-id."
      }
    },
    {
      "name": "Search Movies",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Movie/search?query={{searchQuery}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Movie", "search"],
          "query": [
            {
              "key": "query",
              "value": "{{searchQuery}}"
            }
          ]
        },
        "description": "Söker filmer via titel."
      }
    },
    {
      "name": "Get Movie Credits",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Movie/{{tmdbId}}/credits",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Movie", "{{tmdbId}}", "credits"]
        },
        "description": "Hämtar cast/crew för en film."
      }
    },
    {
      "name": "Get Movie Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/Movie/{{tmdbId}}/details",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Movie", "{{tmdbId}}", "details"]
        },
        "description": "Hämtar detaljerad filminfo."
      }
    }
  ]
}
