# Copy to .env and fill in. Docker Compose reads .env automatically.

# SQL Server sa password. Needs 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe_123!

# JWT signing key. At least 32 characters.
JWT_KEY=replace-with-a-long-random-string-of-32-plus-chars

# TMDB API Read Access Token (https://www.themoviedb.org/settings/api).
TMDB_READ_ACCESS_TOKEN=
